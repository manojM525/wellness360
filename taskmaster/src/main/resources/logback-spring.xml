<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name"/>

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Fixed fields on every log line — this is what makes CloudWatch
                 Logs Insights queries like `fields level, message | filter level="ERROR"`
                 work directly, instead of parsing a plain-text pattern layout. -->
            <customFields>{"application":"${appName}"}</customFields>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE_JSON"/>
    </root>

    <!-- Container logs go to stdout only — never to a file inside the
         container. Fargate's filesystem is ephemeral; a log file would
         vanish the moment the task recycles. stdout -> awslogs driver ->
         CloudWatch Logs is the only durable path. -->
</configuration>
